<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>

<IfModule mod_headers.c>
  # The service worker must always be re-checked so updates roll out.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Stops Apache guessing a different file (e.g. foo.php vs foo.phtml) before
  # our rewrite rule runs — a common cause of routes silently 404ing or
  # falling back to directory listings on shared hosts.
  Options -MultiViews -Indexes

  # Serve real files/directories (assets, uploads, etc.) directly...
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ...everything else is routed through the single front controller.
  # No RewriteBase is set on purpose: Apache derives it from this file's own
  # directory, so the same rule works whether the app is hosted at the
  # domain root or in a subfolder (e.g. /Ujuzi/public/). If your host
  # requires an explicit RewriteBase, uncomment and set it to match the
  # public folder's URL path:
  # RewriteBase /Ujuzi/public/
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
  DirectoryIndex index.php
</IfModule>
