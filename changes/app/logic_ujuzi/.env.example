# Copy this file to .env and fill in real values. Never commit .env.

# REQUIRED on every host: set this to the exact URL the app is served at,
# with no trailing slash. This is what fixes broken links, redirects, and
# asset paths ("permalinks") after hosting — without it, the app guesses
# its own base path from server variables, which shared hosts, subfolder
# hosting, and reverse proxies frequently get wrong.
#   Local (AMPPS):        APP_URL=http://localhost/ujuzi-training/public
#   Hosted at domain root: APP_URL=https://example.com
#   Hosted in a subfolder: APP_URL=https://dazuaihub.com/Ujuzi/public
APP_URL=http://localhost/ujuzi-training/public
APP_NAME="Ujuzi Training"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ujuzi_training
DB_USER=root
DB_PASS=

# --- SMTP (used for OTP login codes) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=changeme
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Ujuzi Training"

# --- Super Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
